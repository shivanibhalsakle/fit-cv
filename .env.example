# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Database ---------------------------------------------------------------
# Local dev (matches docker-compose.yml; port 5433 avoids clashing with any
# Postgres already running on 5432).
DATABASE_URL="postgresql://resume:localdev@localhost:5433/resume_optimizer?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The ONLY GitHub username permitted to sign in. Leaving this blank locks
# everyone out (fails closed) rather than letting any account in.
ALLOWED_GITHUB_LOGIN=""

# --- Claude API -------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Only needed if your API key is NOT scoped to a workspace (i.e. created at the
# organization level). A workspace-scoped key works without this.
# Find it in the Console URL when viewing the workspace: .../workspaces/<id>
ANTHROPIC_WORKSPACE_ID=""


# --- GitHub sync (Phase 8, not needed yet) ----------------------------------
# Read-only personal access token, public_repo scope (or repo for private).
GITHUB_TOKEN=""
